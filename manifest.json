{
  "manifest_version": 3,
  "name": "Tab URL Copier",
  "version": "1.0.0",
  "description": "Copy open tab URLs to clipboard one per line across customizable scopes.",
  "permissions": [
    "tabs",
    "contextMenus",
    "offscreen",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
